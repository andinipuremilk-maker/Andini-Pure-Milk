# ============================================================================
# KONFIGURASI ENVIRONMENT — Andini Pure Milk POS
# Salin file ini menjadi .env.local (lokal) atau isi di dashboard hosting
# (mis. Vercel → Project Settings → Environment Variables).
# ============================================================================

# --- MODE DATABASE ----------------------------------------------------------
# true  = Pakai Supabase (WAJIB untuk produksi; data tersimpan permanen)
# false = Pakai database lokal in-memory (hanya untuk demo/pengembangan;
#         data HILANG setiap server restart)
USE_SUPABASE=true

# --- SUPABASE ---------------------------------------------------------------
# Dapatkan di: Supabase Dashboard -> Project Settings -> API
# Jalankan supabase/schema.sql di SQL Editor Supabase sebelum deploy.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Rahasia! Jangan pernah dibagikan atau dipakai di kode frontend.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- SESI LOGIN -------------------------------------------------------------
# Kunci rahasia untuk menandatangani cookie login (minimal 32 karakter acak).
# Buat dengan perintah: openssl rand -base64 48
# Tanpa ini, login akan ditolak di produksi.
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# --- SEED DATA (OPSIONAL) ---------------------------------------------------
# Endpoint POST /api/seed MENGHAPUS semua transaksi lalu mengisi data contoh.
# Di produksi dinonaktifkan kecuali diset true. Biarkan false.
ALLOW_SEED=false
